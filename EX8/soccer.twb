      <column caption='Total Goals' datatype='integer' name='[Calculation_0763656350752768]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([home_team_goal]) + SUM([away_team_goal])' />
      </column>
      <column caption='Average Goals per Match' datatype='real' name='[Calculation_0763656351322113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([home_team_goal]) + SUM([away_team_goal])) / COUNT([id])' />
      </column>
      <column caption='Match Result' datatype='string' name='[Calculation_0763656352280578]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [home_team_goal] &gt; [away_team_goal] THEN &quot;Home Win&quot;&#13;&#10;ELSEIF [home_team_goal] &lt; [away_team_goal] THEN &quot;Away Win&quot;&#13;&#10;ELSE &quot;Draw&quot;&#13;&#10;END' />
      </column>
