    <worksheet name='Sheet 5'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Times New Roman' fontsize='10'>5.Fee type, Category (Calculated Field)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Top Indian Places to Visit' name='federated.04knr220133wcq11xgk7n1vkh4ri' />
          </datasources>
          <datasource-dependencies datasource='federated.04knr220133wcq11xgk7n1vkh4ri'>
            <column caption='Fee type' datatype='string' name='[Calculation_0494269233852418]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Entrance Fee in INR] = 0 THEN &quot;Free&quot;&#13;&#10;ELSE &quot;Paid&quot;&#13;&#10;END' />
            </column>
            <column caption='Rating Category' datatype='string' name='[Calculation_0494269234352131]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Google review rating] &gt;= 4.5 THEN &quot;Excellent&quot;&#13;&#10;ELSEIF [Google review rating] &gt;= 4.0 THEN &quot;Good&quot;&#13;&#10;ELSE &quot;Average&quot;&#13;&#10;END' />
            </column>
            <column datatype='integer' name='[Entrance Fee in INR]' role='measure' type='quantitative' />
            <column datatype='real' name='[Google review rating]' role='measure' type='quantitative' />
            <column datatype='string' name='[Name]' role='dimension' type='nominal' />
            <column datatype='string' name='[State]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column-instance column='[Calculation_0494269233852418]' derivation='None' name='[none:Calculation_0494269233852418:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0494269234352131]' derivation='None' name='[none:Calculation_0494269234352131:nk]' pivot='key' type='nominal' />
            <column-instance column='[Name]' derivation='None' name='[none:Name:nk]' pivot='key' type='nominal' />
